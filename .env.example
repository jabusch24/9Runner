# ---------------------------------------------------------------------------
# 9Runner configuration. Copy to .env and fill in. Every value can also be
# passed on the command line: `npm run benchmark:iwm -- --peak-rps 6000`.
# ---------------------------------------------------------------------------

# --- Deployments (set the ones you have; unset ones are skipped) -----------
# Use a database user with readWriteAnyDatabase + clusterMonitor (Atlas: "Atlas admin"
# works) so the monitor can read serverStatus.
MONGO_8_URI=
MONGO_8_TIER="M30 · AWS eu-central-1 · 8.0.x"
MONGO_8_ATLAS_CLUSTER=

# MongoDB 9 WITHOUT IWM. On Atlas Dedicated 9.0+ IWM's always-on protections cannot be
# disabled, so leave this empty unless you have a self-managed 9.0 deployment.
MONGO_9_URI=
MONGO_9_TIER=

MONGO_9_IWM_URI=
MONGO_9_IWM_TIER="M30 · AWS eu-central-1 · 9.0 · Load Shedding: Disabled"
MONGO_9_IWM_ATLAS_CLUSTER=

MONGO_9_IWM_LS_URI=
MONGO_9_IWM_LS_TIER="M30 · AWS eu-central-1 · 9.0 · Load Shedding: Enabled"
MONGO_9_IWM_LS_ATLAS_CLUSTER=

# Local rehearsal: `docker compose up -d` (MongoDB 8.3 + Search). IWM is EMULATED with
# static server parameters - see README "Local rehearsal".
LOCAL_URI=mongodb://localhost:27017/?directConnection=true

DB_NAME=ecommerce_demo

# --- Dataset ------------------------------------------------------------------
SEED=mongodb-9-demo
PRODUCT_COUNT=500000
REVIEW_COUNT=2000000
ORDER_COUNT=200000
SEED_BATCH_SIZE=5000
SEED_CONCURRENCY=4

# --- Request/response benchmarks (search, facets, aggregation) ----------------
WARMUP_ITERATIONS=10
MEASURED_ITERATIONS=100
BENCH_CONCURRENCY=4
THROUGHPUT_SECONDS=10
MAX_VARIANT_SECONDS=90

# --- Stress tests (iwm, load-shedding, mongo8-vs-9, calibrate) ----------------
# Pick BASE/PEAK with `npm run calibrate` - the right values depend on tier and mix.
BASE_RPS=1000
PEAK_RPS=8000
BASELINE_SECONDS=30
RAMP_SECONDS=30
# RAMP_STEPS=2000,4000,8000,12000
OVERLOAD_SECONDS=60
RECOVERY_SECONDS=30
STEADY_SECONDS=60
# LOAD_PHASES=baseline:30:1000,ramp:30:1000-8000,overload:60:8000,recovery:30:1000

SLO_MS=500
OP_TIMEOUT_MS=5000
WORKERS=4
POOL_SIZE_PER_WORKER=250
MAX_INFLIGHT_PER_WORKER=5000
# none = raw server behaviour | app = retry overload errors with backoff (counted) | driver = driver defaults
CLIENT_RETRY_MODE=none
LS_RETRY_MODES=none,app
APP_MAX_RETRIES=3
COOLDOWN_SECONDS=30
CANARY_RPS=5
# 60% reads, 20% writes, 10% aggregations, 10% expensive (the default):
# WORKLOAD_MIX=product-page:35,category-listing:17,search:8,checkout:10,inventory:10,analytics:10,heavy-report:10

# --- Local emulation (LOCAL_URI only) -----------------------------------------
EMULATION_RATE_PER_SEC=1500
EMULATION_QUEUE_DEPTH=100000
EMULATION_SHED_QUEUE_DEPTH=50
# LOCAL_EMULATION_MODES=off,queue,shed

# --- Optional: Atlas Administration API metrics (service account) ------------
ATLAS_CLIENT_ID=
ATLAS_CLIENT_SECRET=
ATLAS_GROUP_ID=
# ATLAS_GRANULARITY=PT10S

PORT=3000
